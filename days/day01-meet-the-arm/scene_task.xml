<mujoco model="so101_pick_bucket_task">
  <include file="so101_new_calib.xml" />

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
    <light pos="0.3 -0.3 2" dir="0 0 -1" directional="true" />
    <camera name="front" pos="0 -0.35 0.42" xyaxes="0.912 -0.417 0 0.287 0.628 0.722" fovy="60" />
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

    <!-- work table in front of the arm (arm base sits below tabletop, like the
         real kit; the shoulder housing is collision-off so pan never grinds it) -->
    <geom name="table" type="box" size="0.30 0.25 0.04" pos="0.20 0.05 0.04" rgba="0.75 0.65 0.45 1" />

    <!-- the payload: a 3 cm red cube on a pedestal (the SO-101 claw plane sits
         ~55 mm above its site, so the cube must be raised for jaws to straddle it) -->
    <!-- slim pedestal: just tall enough to raise the cube into the claw's grip
         plane, narrow enough for the jaws to straddle past it -->
    <geom name="pedestal" type="box" size="0.008 0.008 0.0355" pos="0.16 0 0.1155" rgba="0.6 0.55 0.45 1" />
    <body name="cube" pos="0.16 0 0.166">
      <freejoint />
      <geom name="cube" type="box" size="0.015 0.015 0.015" mass="0.02" rgba="0.85 0.1 0.1 1" friction="1.0 0.8 0.8" solref="0.003 1" solimp="0.98 0.98 0.001" />
    </body>

    <!-- open box on the tabletop: 4 walls, tabletop is the bottom -->
    <!-- open box on the tabletop: 4 walls, tabletop is the bottom.
         placed at (0.10 0.20): inside the arm's min-reach circle the claw
         can never hover over it (tried (0.02 0.145): unreachable). -->
    <body name="bucket" pos="0.10 0.20 0.08">
      <geom name="bucket_front"  type="box" size="0.04 0.004 0.035" pos="0  0.04 0.0175"   rgba="0.15 0.35 0.75 0.35" />
      <geom name="bucket_back"   type="box" size="0.04 0.004 0.035" pos="0 -0.04 0.0175"   rgba="0.15 0.35 0.75 0.35" />
      <geom name="bucket_left"   type="box" size="0.004 0.04 0.035" pos="-0.04 0 0.0175"   rgba="0.15 0.35 0.75 0.35" />
      <geom name="bucket_right"  type="box" size="0.004 0.04 0.035" pos=" 0.04 0 0.0175"   rgba="0.15 0.35 0.75 0.35" />
    </body>
  </worldbody>

  <!-- shortcut: physical jaw-vs-mesh calibration on this arm can't straddle a
       cube (probe1..13), so closing near the cube welds it to the gripper.
       Ungrade later to real contact-grasp if the MJCF gains a corrected jaw. -->
  <equality>
    <weld name="sticky_grip" body1="cube" body2="gripper" active="false" solref="0.004 1" />
  </equality>

  <!-- the welded cube rides inside the claw housing: stop it fighting the arm -->
  <contact>
    <exclude body1="cube" body2="gripper" />
    <exclude body1="cube" body2="moving_jaw_so101_v1" />
    <exclude body1="cube" body2="wrist" />
  </contact>
</mujoco>
